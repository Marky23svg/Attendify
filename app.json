{
  "expo": {
    "name": "Attendify",
    "slug": "Attendify_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "attendifyapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Attendify to use your camera to capture selfies for attendance verification.",
        "NSLocationWhenInUseUsageDescription": "Allow Attendify to use your location to verify where you clocked in."
      }
    },
    "android": {
      "package": "com.imnotmarkkk.attendify",
      "adaptiveIcon": {
        "backgroundColor": "#0171FB",
        "foregroundImage": "./assets/images/Attendify-logo.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0055FF",
          "image": "./assets/images/Attendify-logo-white.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Attendify to use your camera to capture selfies for attendance verification."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Attendify to use your location to verify where you clocked in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Attendify to access your photos to attach an attendance selfie.",
          "cameraPermission": "Allow Attendify to use your camera to capture selfies for attendance verification.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b7726ed1-f3af-4c05-83c5-db808db3669f"
      }
    },
    "owner": "imnotmarkkk"
  }
}
