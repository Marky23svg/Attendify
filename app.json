{
  "expo": {
    "name": "Attendify_app",
    "slug": "Attendify_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "attendifyapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Attendify to use your camera to capture selfies for attendance verification.",
        "NSLocationWhenInUseUsageDescription": "Allow Attendify to use your location to verify where you clocked in."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0171FB",
        "foregroundImage": "./assets/images/Attendify-logo.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0171FB",
          "image": "./assets/images/Attendify-logo.png",
          "imageWidth": 100
        }
      ],
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Attendify to use your camera to capture selfies for attendance verification."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Attendify to use your location to verify where you clocked in."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
